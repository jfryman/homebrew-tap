#!/usr/bin/env bash
# Point Formula/<name>.rb at a release tag of jfryman/<name>. Portable (perl), so it runs on the
# Linux and macOS runners alike.
#   bump-formula NAME VERSION SHA256      (VERSION without the leading "v")
set -euo pipefail

name=$1 version=$2 sha=$3
formula="Formula/${name}.rb"

[[ $name =~ ^[a-z0-9-]+$ ]] || { echo "bad name: $name" >&2; exit 1; }
[[ $version =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || { echo "bad version: $version" >&2; exit 1; }
[[ $sha =~ ^[0-9a-f]{64}$ ]] || { echo "bad sha256: $sha" >&2; exit 1; }

url="https://github.com/jfryman/${name}/archive/refs/tags/v${version}.tar.gz"
# Only the first url/sha256 (the formula's own source); resource blocks are indented deeper.
URL="$url" SHA="$sha" perl -0pi -e '
  s{^  url "[^"]*"}{  url "$ENV{URL}"}m;
  s{^  sha256 "[0-9a-f]{64}"}{  sha256 "$ENV{SHA}"}m;
' "$formula"

grep -q "^  url \"${url}\"" "$formula"
grep -q "^  sha256 \"${sha}\"" "$formula"
